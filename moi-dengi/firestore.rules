rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый человек видит и меняет только свои данные
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /tx/{txId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
