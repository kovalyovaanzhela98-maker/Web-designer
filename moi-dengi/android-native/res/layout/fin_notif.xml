<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="4dp">

    <ImageView
        android:id="@+id/n_logo"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Фин"
        android:src="@drawable/fin_logo" />
    <LinearLayout
        android:id="@+id/n_expense"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/fin_btn_prim"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_minus_on" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Расход"
            android:textColor="@color/fin_btn_on"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/n_income"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/fin_btn_soft"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_w_plus_soft" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Доход"
            android:textColor="@color/fin_btn_soft_text"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>
    <ImageView
        android:id="@+id/n_voice"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/fin_btn_soft"
        android:contentDescription="Голосом"
        android:padding="11dp"
        android:src="@drawable/ic_w_mic"
        android:layout_marginStart="8dp" />
</LinearLayout>
